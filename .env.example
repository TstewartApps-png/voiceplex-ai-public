# VoicePlex AI Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME=VoicePlex
APP_ENV=development
DEBUG=true

# Secret key for JWT signing - must be at least 32 characters
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-256-bit-secret-key-change-this-in-production

# Encryption key for OAuth tokens - must be at least 32 characters
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=your-32-byte-encryption-key-change-this-in-production

# =============================================================================
# URLS
# =============================================================================
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# Voice server (voice-server/): ws://localhost:8765/ws locally. Tenants can override in Settings.
PERSONAPLEX_URL=ws://localhost:8765/ws

# =============================================================================
# MONGODB
# =============================================================================
MONGODB_URI=mongodb://localhost:27017/voiceplex
MONGODB_DB_NAME=voiceplex

# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/voiceplex?retryWrites=true&w=majority

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# CLAUDE / ANTHROPIC API
# =============================================================================
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# Primary model for low-latency voice turns, fallback for prompt generation
CLAUDE_MODEL=claude-3-haiku-20240307
CLAUDE_MODEL_FALLBACK=claude-3-5-sonnet-20241022

# Claude response settings
CLAUDE_MAX_TOKENS=1024
CLAUDE_TEMPERATURE=0.7
CLAUDE_TIMEOUT_SECONDS=30

# =============================================================================
# TWILIO
# =============================================================================
TWILIO_ACCOUNT_SID=ACxxxxx
TWILIO_AUTH_TOKEN=xxxxx
TWILIO_API_KEY_SID=SKxxxxx
TWILIO_API_KEY_SECRET=xxxxx

# =============================================================================
# GOOGLE OAUTH
# =============================================================================
# Create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials
# Required scopes: calendar, calendar.events, gmail.send, gmail.compose, userinfo.email
# Add redirect URI to OAuth client: http://localhost:8000/api/v1/integrations/google/callback
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback

# =============================================================================
# MICROSOFT OAUTH
# =============================================================================
# Create app registration at https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
# Required API permissions: User.Read, Calendars.ReadWrite, Mail.Send, offline_access
# Add redirect URI (Web): http://localhost:8000/api/v1/integrations/microsoft/callback
MICROSOFT_CLIENT_ID=xxxxx
MICROSOFT_CLIENT_SECRET=xxxxx
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/integrations/microsoft/callback
MICROSOFT_TENANT_ID=common

# =============================================================================
# STRIPE
# =============================================================================
# Get keys from https://dashboard.stripe.com/apikeys
# For local testing, use test keys (sk_test_* and pk_test_*)
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# Webhook secret - get from Stripe Dashboard > Developers > Webhooks
# For local testing, use Stripe CLI: stripe listen --forward-to localhost:8000/api/v1/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Stripe Price IDs - create products/prices in Stripe Dashboard
# Create a product for each plan, then copy the price ID
# Monthly recurring prices are required for subscription checkout
STRIPE_PRICE_STARTER=price_xxxxx
STRIPE_PRICE_GROWTH=price_xxxxx
STRIPE_PRICE_PROFESSIONAL=price_xxxxx
STRIPE_PRICE_AGENCY=price_xxxxx

# =============================================================================
# RUNPOD (optional, only if you host the voice server there)
# =============================================================================
RUNPOD_API_KEY=xxxxx
RUNPOD_ENDPOINT_ID=xxxxx

# =============================================================================
# DEV
# =============================================================================
# DEV_MODE=true bypasses subscription limits (agents/companies per plan)
DEV_MODE=false

# =============================================================================
# JWT SETTINGS (Optional - defaults provided)
# =============================================================================
# JWT_ALGORITHM=HS256
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# RATE LIMITING (Optional - defaults provided)
# =============================================================================
# RATE_LIMIT_PER_MINUTE=60
